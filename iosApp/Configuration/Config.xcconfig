TEAM_ID=

PRODUCT_NAME=moltonf-kmp
PRODUCT_BUNDLE_IDENTIFIER=com.hironytic.moltonfkmp.moltonf-kmp$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Shared framework is built as a static framework; system libraries it
// depends on transitively (sqlite3, used by SQLDelight's NativeSqliteDriver)
// are not linked automatically and must be listed here.
OTHER_LDFLAGS=$(inherited) -lsqlite3